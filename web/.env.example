# Chep file nay thanh .env roi dien thong tin that.
# KHONG commit file .env len GitHub vi trong do co mat khau.
#
#   copy .env.example .env        (Windows)
#   cp .env.example .env          (Linux / macOS)

# ---------------------------------------------------------------------------
# MQTT - phai trung voi Config.h ben ESP32
# ---------------------------------------------------------------------------
MQTT_HOST=broker.hivemq.com
MQTT_PORT=1883

# Doi gia tri nay thi PHAI doi luon MQTT_BASE trong
# esp32/SmartDrain_ESP32/Config.h, neu khong hai ben khong noi chuyen duoc.
# Nen doi thanh ten rieng khi dung broker cong cong, vi du: smartdrain-24127476
MQTT_BASE=smartdrain

# ---------------------------------------------------------------------------
# Firebase Realtime Database
# De trong thi website tu dong luu vao SQLite (web/data/smartdrain.db)
# ---------------------------------------------------------------------------
# FIREBASE_DB_URL=
# FIREBASE_AUTH=

# ---------------------------------------------------------------------------
# Email canh bao
# Voi Gmail phai bat xac thuc 2 buoc roi tao "App password" 16 ky tu,
# KHONG dung mat khau dang nhap thuong.
# ---------------------------------------------------------------------------
EMAIL_ENABLED=0
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_TO=

# Khoang cach toi thieu giua hai email, tinh bang giay
EMAIL_MIN_INTERVAL=120

# ---------------------------------------------------------------------------
# Flask
# ---------------------------------------------------------------------------
FLASK_PORT=5000
FLASK_DEBUG=0
